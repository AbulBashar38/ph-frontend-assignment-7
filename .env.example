# Backend origin (server-only). /api/v1/* is rewritten to it.
# Live: https://ph-backend-assignment-6.vercel.app
API_URL=http://localhost:5050

# This site's public URL (metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match the backend's GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Dedicated demo accounts for the one-click demo login (never real passwords)
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_TENANT_EMAIL=
NEXT_PUBLIC_DEMO_TENANT_PASSWORD=
NEXT_PUBLIC_DEMO_OWNER_EMAIL=
NEXT_PUBLIC_DEMO_OWNER_PASSWORD=
